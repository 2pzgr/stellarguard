# Frontend Environment Variables Example
# Copy this file to .env.local and update with your values
# See frontend/docs/ENVIRONMENT_SETUP.md for detailed configuration guide

# Stellar Network Configuration
# Set NEXT_PUBLIC_NETWORK to "testnet", "futurenet", or "mainnet" (defaults to testnet)
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Development Mode: Use mock data instead of real contracts
# Set NEXT_PUBLIC_USE_MOCK_TREASURY=1 to enable mock mode (contract IDs below become optional)
# Unset or remove this line to use real contracts (contract IDs required below)
# NEXT_PUBLIC_USE_MOCK_TREASURY=1

# Contract IDs (Required unless NEXT_PUBLIC_USE_MOCK_TREASURY=1)
# Populate these after deploying contracts to the Stellar network
NEXT_PUBLIC_TREASURY_CONTRACT_ID=
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ID=
NEXT_PUBLIC_VAULT_CONTRACT_ID=
NEXT_PUBLIC_ACL_CONTRACT_ID=

# Application Configuration
NEXT_PUBLIC_APP_NAME=StellarGuard
NEXT_PUBLIC_APP_VERSION=0.1.0

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true
